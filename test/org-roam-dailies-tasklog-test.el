;;; org-roam-dailies-tasklog-test.el --- Tasklog tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'org-roam-dailies-tasklog)

(defconst tasklog-test--clock
  "CLOCK: [2026-11-02 Mon 09:00]--[2026-11-02 Mon 10:30] => 1:30")

(defmacro tasklog-test--with-daily (&rest body)
  `(let ((org-roam-directory (make-temp-file "tasklog-test-" t))
         (org-roam-dailies-directory "daily/")
         (org-roam-dailies-tasklog-mode nil))
     (unwind-protect
         (with-temp-buffer
           (setq buffer-file-name
                 (expand-file-name "daily/2026-11-02.org" org-roam-directory))
           (org-mode)
           (insert "* TODO Write proposal\n:LOGBOOK:\n"
                   tasklog-test--clock "\n:END:\nMy notes.\n")
           (org-roam-dailies-tasklog-mode 1)
           ,@body)
       (org-roam-dailies-tasklog-mode -1)
       (delete-directory org-roam-directory t))))

(ert-deftest tasklog-overlay-lifecycle-and-refresh ()
  (tasklog-test--with-daily
   (set-buffer-modified-p nil)
   (let ((original (buffer-string)))
     (org-roam-dailies-tasklog--refresh-time-overlays)
     (should-not (buffer-modified-p))
     (should (equal original (buffer-string)))
     (should (= 1 (length org-roam-dailies-tasklog--time-overlays)))
     (should (equal "     09:00 AM → 10:30 AM [1:30]"
                    (overlay-get (car org-roam-dailies-tasklog--time-overlays)
                                 'after-string)))
     (goto-char (point-min))
     (search-forward "Write proposal")
     (insert " draft")
     (should (= (line-end-position)
                (overlay-start (car org-roam-dailies-tasklog--time-overlays)))))
   (org-roam-dailies-tasklog-mode -1)
   (should-not org-roam-dailies-tasklog--time-overlays)
   (should-not (memq #'org-roam-dailies-tasklog--refresh-time-overlays
                    after-change-functions))))

(ert-deftest tasklog-legacy-headings-do-not-get-duplicate-times ()
  (tasklog-test--with-daily
   (goto-char (point-min))
   (end-of-line)
   (insert "     09:00 AM → 10:30 AM [1:30]")
   (should-not org-roam-dailies-tasklog--time-overlays)))

(ert-deftest tasklog-running-clock-display ()
  (tasklog-test--with-daily
   (goto-char (point-min))
   (search-forward "--[2026-11-02 Mon 10:30] => 1:30")
   (replace-match "" t t)
   (should (equal "     09:00 AM → running"
                  (overlay-get (car org-roam-dailies-tasklog--time-overlays)
                               'after-string)))))

(ert-deftest tasklog-display-is-limited-to-dailies ()
  (tasklog-test--with-daily
   (setq buffer-file-name (expand-file-name "tasks.org" org-roam-directory))
   (org-roam-dailies-tasklog--refresh-time-overlays)
   (should-not org-roam-dailies-tasklog--time-overlays)))

(ert-deftest tasklog-opening-daily-installs-display ()
  (tasklog-test--with-daily
   ;; Re-entering Org mode exercises the hook used when opening a note.
   (org-mode)
   (should (= 1 (length org-roam-dailies-tasklog--time-overlays)))
   (should (memq #'org-roam-dailies-tasklog--refresh-time-overlays
                 after-change-functions))
   (fundamental-mode)
   (should-not (overlays-in (point-min) (point-max)))))

(ert-deftest tasklog-missing-clock-removes-display ()
  (tasklog-test--with-daily
   (goto-char (point-min))
   (forward-line 1)
   (delete-region (point) (point-max))
   (should-not org-roam-dailies-tasklog--time-overlays)))

(defmacro tasklog-test--with-source (&rest body)
  `(let* ((org-roam-directory (make-temp-file "tasklog-flow-" t))
          (org-roam-dailies-directory "daily/")
          (org-id-locations-file (expand-file-name "ids" org-roam-directory))
          (org-id-locations nil)
          (org-id-track-globally t)
          (org-clock-into-drawer "LOGBOOK")
          (org-clock-persist nil)
          (org-clock-history nil)
          (org-clock-in-hook nil)
          (org-clock-out-hook nil)
          (org-after-todo-state-change-hook nil)
          (org-clock-in-switch-to-state nil)
          (org-clock-out-switch-to-state nil)
          (org-clock-out-remove-zero-time-clocks nil)
          (org-log-done nil)
          (org-roam-dailies-tasklog-mode nil)
          (source (find-file-noselect (expand-file-name "tasks.org" org-roam-directory))))
     (unwind-protect
         (with-current-buffer source
           (insert "* TODO Write proposal\n* TODO Write proposal\n* TODO Write proposal draft\n")
           (goto-char (point-min))
           (org-roam-dailies-tasklog-mode 1)
           ,@body)
       (org-roam-dailies-tasklog-mode -1)
       (when (org-clocking-p) (org-clock-cancel))
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (file-in-directory-p (buffer-file-name buffer) org-roam-directory))
           (with-current-buffer buffer (set-buffer-modified-p nil))
           (kill-buffer buffer)))
       (delete-directory org-roam-directory t))))

(defun tasklog-test--read (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(ert-deftest tasklog-real-clock-and-reopen-flow ()
  (tasklog-test--with-source
   (org-clock-in nil (encode-time 0 0 9 2 11 2026))
   (let ((file (org-entry-get nil "TASKLOG_FILE")))
     (should file)
     (should (string-match-p "Source: \\[\\[id:" (tasklog-test--read file)))
     (should-not (string-match-p " → " (tasklog-test--read file)))
     (org-clock-out nil nil (encode-time 0 30 10 2 11 2026))
     (should (string-match-p "=>  *1:30" (tasklog-test--read file)))
     (org-todo "DONE")
     (should (string-match-p "^\\* DONE Write proposal$" (tasklog-test--read file)))
     (org-todo "TODO")
     (should (string-match-p "^\\* TODO Write proposal$" (tasklog-test--read file)))
     (should (= 1 (with-temp-buffer (insert-file-contents file)
                                   (how-many "^\\* " (point-min) (point-max))))))))

(ert-deftest tasklog-duplicate-titles-and-renames ()
  (tasklog-test--with-source
   (org-clock-in nil (encode-time 0 0 9 2 11 2026))
   (org-clock-out nil nil (encode-time 0 30 9 2 11 2026))
   (let ((file (org-entry-get nil "TASKLOG_FILE"))
         (first-id (org-entry-get nil "ID")))
     (outline-next-heading)
     (org-clock-in nil (encode-time 0 0 10 2 11 2026))
     (should-not (equal first-id (org-entry-get nil "ID")))
     (org-edit-headline "Renamed task")
     (org-clock-out nil nil (encode-time 0 45 10 2 11 2026))
     (org-todo "DONE")
     (let ((content (tasklog-test--read file)))
       (should (string-match-p "^\\* TODO Write proposal$" content))
       (should (string-match-p "^\\* DONE Write proposal$" content))
       (should (string-match-p "=>  *0:30" content))
       (should (string-match-p "=>  *0:45" content))))))

(ert-deftest tasklog-midnight-routing-survives-reload ()
  (tasklog-test--with-source
   (cl-letf (((symbol-function 'current-time)
              (lambda () (encode-time 0 50 23 2 11 2026))))
     (org-clock-in nil (encode-time 0 50 23 2 11 2026)))
   (let ((file (org-entry-get nil "TASKLOG_FILE")))
     (should (string-suffix-p "2026-11-02.org" file))
     (save-buffer)
     ;; Session routing is in the file, not a process-local session table.
     (org-roam-dailies-tasklog-mode -1)
     (revert-buffer t t)
     (org-roam-dailies-tasklog-mode 1)
     (cl-letf (((symbol-function 'current-time)
                (lambda () (encode-time 0 10 0 3 11 2026))))
       (goto-char (point-min))
       ;; Restored clock data is what a persisted Org clock supplies.
       (search-forward "CLOCK:")
       (end-of-line)
       (insert "--[2026-11-03 Tue 00:10] => 0:20")
       (org-back-to-heading t)
       (org-roam-dailies-tasklog--handle-clock-out))
     (should (string-match-p "=> 0:20" (tasklog-test--read file)))
     (should-not (file-exists-p (expand-file-name "daily/2026-11-03.org" org-roam-directory))))))

(ert-deftest tasklog-preserves-notes-properties-and-children ()
  (tasklog-test--with-source
   (org-clock-in nil (encode-time 0 0 9 2 11 2026))
   (let* ((file (org-entry-get nil "TASKLOG_FILE"))
          (daily (find-file-noselect file)))
     (with-current-buffer daily
       (goto-char (point-min)) (re-search-forward "^\\* ")
       (org-entry-put nil "CUSTOM" "keep this")
       (search-forward ":LOGBOOK:") (beginning-of-line)
       (insert "Notes before clock.\n")
       (search-forward ":END:") (end-of-line)
       (insert "\nNotes after clock.\n** Child heading\nChild notes.\n"))
     (org-clock-out nil nil (encode-time 0 30 10 2 11 2026))
     (org-todo "DONE")
     (let ((content (tasklog-test--read file)))
       (dolist (text '("Notes before clock." "Notes after clock."
                       "** Child heading\nChild notes." "keep this"))
         (should (string-match-p (regexp-quote text) content)))))))

(ert-deftest tasklog-overlay-options-and-local-refresh ()
  (tasklog-test--with-daily
   (goto-char (point-max))
   (insert "\n* TODO Other task\n:LOGBOOK:\n" tasklog-test--clock "\n:END:\n")
   (let ((org-roam-dailies-tasklog-time-format "%H:%M")
         (org-roam-dailies-tasklog-compact-duration t)
         (org-roam-dailies-tasklog-time-column 40))
     (org-roam-dailies-tasklog-refresh)
     (let ((last (car (sort (copy-sequence org-roam-dailies-tasklog--time-overlays)
                            (lambda (a b) (> (overlay-start a) (overlay-start b)))))))
       (goto-char (point-min)) (end-of-line) (insert " edited")
       (should (memq last org-roam-dailies-tasklog--time-overlays))
       (let ((label (overlay-get (car org-roam-dailies-tasklog--time-overlays) 'after-string)))
         (should (string-match-p "09:00 → 10:30 \\[1h 30m\\]" label)))))))

(ert-deftest tasklog-real-midnight-clock-out ()
  (tasklog-test--with-source
   (cl-letf (((symbol-function 'current-time)
              (lambda () (encode-time 0 50 23 2 11 2026))))
     (org-clock-in nil (encode-time 0 50 23 2 11 2026)))
   (let ((file (org-entry-get nil "TASKLOG_FILE")))
     (cl-letf (((symbol-function 'current-time)
                (lambda () (encode-time 0 10 0 3 11 2026))))
       (org-clock-out nil nil (encode-time 0 10 0 3 11 2026)))
     (should (string-match-p "=>  *0:20" (tasklog-test--read file)))
     (should-not (file-exists-p (expand-file-name "daily/2026-11-03.org" org-roam-directory))))))

(ert-deftest tasklog-new-sessions-preserve-history-and-daily-edits-do-not-relog ()
  (tasklog-test--with-source
   (org-clock-in nil (encode-time 0 0 9 2 11 2026))
   (org-clock-out nil nil (encode-time 0 30 9 2 11 2026))
   (let ((file (org-entry-get nil "TASKLOG_FILE"))
         (first-session (org-entry-get nil "TASKLOG_SESSION")))
     (org-clock-in nil (encode-time 0 0 10 2 11 2026))
     (should-not (equal first-session (org-entry-get nil "TASKLOG_SESSION")))
     (org-clock-out nil nil (encode-time 0 45 10 2 11 2026))
     (org-todo "DONE")
     (with-current-buffer (find-file-noselect file)
       (goto-char (point-min)) (re-search-forward "^\\* TODO ")
       (should (equal first-session (org-entry-get nil "TASKLOG_SESSION")))
       (outline-next-heading)
       (should (equal "DONE" (org-get-todo-state)))
       (org-todo "TODO")
       (should (= 2 (how-many "^\\* " (point-min) (point-max)))))
     (should (equal "DONE" (org-get-todo-state)))
     (org-todo "TODO")
     (let ((content (tasklog-test--read file)))
       (should-not (string-match-p "TODO TODO" content))
       (should-not (string-match-p "DONE TODO" content))))))

(ert-deftest tasklog-completion-without-clocking-and-source-link ()
  (tasklog-test--with-source
   (org-todo "DONE")
   (let ((file (org-entry-get nil "TASKLOG_FILE"))
         (id (org-entry-get nil "ID")))
     (should-not (string-match-p "CLOCK:" (tasklog-test--read file)))
     (save-buffer)
     (with-current-buffer (find-file-noselect file)
       (goto-char (point-min)) (re-search-forward "^\\* ")
       (should (equal (org-id-find-id-in-file id (buffer-file-name source) 'marker)
                      (with-current-buffer source
                        (goto-char (point-min)) (point-marker))))
       (cl-letf (((symbol-function 'org-id-goto)
                  (lambda (target) (should (equal target id)))))
         (org-roam-dailies-tasklog-visit-source))))))

(ert-deftest tasklog-overlay-heading-deletion-and-narrowing ()
  (tasklog-test--with-daily
   (goto-char (point-max))
   (insert "\n* TODO Second\n:LOGBOOK:\n" tasklog-test--clock "\n:END:\n")
   (should (= 2 (length org-roam-dailies-tasklog--time-overlays)))
   (goto-char (point-min))
   (search-forward "* TODO Second") (beginning-of-line)
   (delete-region (point-min) (point))
   (should (= 1 (length org-roam-dailies-tasklog--time-overlays)))
   (org-narrow-to-subtree)
   (end-of-line) (insert " changed")
   (should (= 1 (length org-roam-dailies-tasklog--time-overlays)))
   (should (= (line-end-position)
              (overlay-start (car org-roam-dailies-tasklog--time-overlays))))))
